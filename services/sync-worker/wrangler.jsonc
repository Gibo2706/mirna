{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mirna-sync-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false,
  },
  "vars": {
    "MIRNA_ENVIRONMENT": "local",
    "MIRNA_BUILD_COMMIT": "local",
    "MIRNA_PROTOCOL_VERSION": "1",
    "MIRNA_ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173",
    "MIRNA_CLEANUP_BATCH_SIZE": "10",
    "MIRNA_EPHEMERAL_CLEANUP_BATCH_SIZE": "1000",
    "MIRNA_MAX_TOTAL_VAULTS": "50",
    "MIRNA_MAX_TOTAL_PAIRING_REQUESTS": "5000",
    "MIRNA_MAX_ACTIVE_AUTH_CHALLENGES_PER_DEVICE": "5",
    "MIRNA_MAX_ACTIVE_SESSIONS_PER_DEVICE": "5",
    "MIRNA_MAX_DEVICES_PER_VAULT": "10",
    "MIRNA_MAX_ACTIVE_PAIRINGS_PER_VAULT": "3",
    "MIRNA_PAIRING_LIFETIME_SECONDS": "300",
    "MIRNA_CHALLENGE_LIFETIME_SECONDS": "120",
    "MIRNA_ACCESS_SESSION_LIFETIME_SECONDS": "900",
    "MIRNA_DEVICE_AUTHORIZATION_LIFETIME_SECONDS": "2592000",
    "MIRNA_MAX_SNAPSHOT_BYTES": "8388608",
    "MIRNA_MAX_OPERATION_BYTES": "65536",
    "MIRNA_MAX_OPERATIONS_PER_BATCH": "100",
    "MIRNA_MAX_OPERATIONS_PER_VAULT": "5000",
    "MIRNA_MAX_RETAINED_SNAPSHOTS": "3",
    "MIRNA_ORPHAN_LIFETIME_SECONDS": "3600",
    "MIRNA_MAX_RECOVERY_ATTEMPTS": "5",
  },
  "d1_databases": [
    {
      "binding": "MIRNA_SYNC_DB",
      "database_name": "mirna-sync-local",
      // Deliberately not a deployable Cloudflare UUID. Miniflare uses local storage.
      "database_id": "LOCAL_MINIFLARE_ONLY_DO_NOT_DEPLOY",
      "migrations_dir": "migrations",
      "migrations_table": "mirna_d1_migrations",
      "remote": false,
    },
  ],
  "r2_buckets": [
    {
      "binding": "MIRNA_SYNC_BUCKET",
      // Local Miniflare storage label only; it is not a provisioned R2 resource.
      "bucket_name": "mirna-sync-local-miniflare-do-not-deploy",
      "remote": false,
    },
  ],
  "triggers": {
    "crons": ["7 * * * *"],
  },
  "env": {
    "staging": {
      "name": "mirna-sync-staging",
      "workers_dev": true,
      "preview_urls": false,
      "observability": {
        "enabled": false,
      },
      "vars": {
        "MIRNA_ENVIRONMENT": "staging",
        "MIRNA_BUILD_COMMIT": "replace-at-deploy",
        "MIRNA_PROTOCOL_VERSION": "1",
        "MIRNA_ALLOWED_ORIGINS": "https://mirna-finansije-beta.vercel.app,http://localhost:5173,http://127.0.0.1:5173",
        "MIRNA_CLEANUP_BATCH_SIZE": "10",
        "MIRNA_EPHEMERAL_CLEANUP_BATCH_SIZE": "1000",
        "MIRNA_MAX_TOTAL_VAULTS": "50",
        "MIRNA_MAX_TOTAL_PAIRING_REQUESTS": "5000",
        "MIRNA_MAX_ACTIVE_AUTH_CHALLENGES_PER_DEVICE": "5",
        "MIRNA_MAX_ACTIVE_SESSIONS_PER_DEVICE": "5",
        "MIRNA_MAX_DEVICES_PER_VAULT": "10",
        "MIRNA_MAX_ACTIVE_PAIRINGS_PER_VAULT": "3",
        "MIRNA_PAIRING_LIFETIME_SECONDS": "300",
        "MIRNA_CHALLENGE_LIFETIME_SECONDS": "120",
        "MIRNA_ACCESS_SESSION_LIFETIME_SECONDS": "900",
        "MIRNA_DEVICE_AUTHORIZATION_LIFETIME_SECONDS": "2592000",
        "MIRNA_MAX_SNAPSHOT_BYTES": "8388608",
        "MIRNA_MAX_OPERATION_BYTES": "65536",
        "MIRNA_MAX_OPERATIONS_PER_BATCH": "100",
        "MIRNA_MAX_OPERATIONS_PER_VAULT": "5000",
        "MIRNA_MAX_RETAINED_SNAPSHOTS": "3",
        "MIRNA_ORPHAN_LIFETIME_SECONDS": "3600",
        "MIRNA_MAX_RECOVERY_ATTEMPTS": "5",
      },
      "ratelimits": [
        {
          "name": "MIRNA_HEALTH_RATE_LIMITER",
          "namespace_id": "1000",
          "simple": { "limit": 10, "period": 60 },
        },
        {
          "name": "MIRNA_SETUP_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 2, "period": 60 },
        },
        {
          "name": "MIRNA_PAIRING_CREATE_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 5, "period": 60 },
        },
        {
          "name": "MIRNA_PAIRING_ACTION_RATE_LIMITER",
          "namespace_id": "1003",
          "simple": { "limit": 30, "period": 60 },
        },
        {
          "name": "MIRNA_AUTH_CHALLENGE_RATE_LIMITER",
          "namespace_id": "1004",
          "simple": { "limit": 20, "period": 60 },
        },
        {
          "name": "MIRNA_AUTH_SESSION_RATE_LIMITER",
          "namespace_id": "1005",
          "simple": { "limit": 10, "period": 60 },
        },
        {
          "name": "MIRNA_RECOVERY_INIT_RATE_LIMITER",
          "namespace_id": "1006",
          "simple": { "limit": 3, "period": 60 },
        },
        {
          "name": "MIRNA_RECOVERY_ACTION_RATE_LIMITER",
          "namespace_id": "1007",
          "simple": { "limit": 10, "period": 60 },
        },
        {
          "name": "MIRNA_SYNC_READ_RATE_LIMITER",
          "namespace_id": "1008",
          "simple": { "limit": 60, "period": 60 },
        },
        {
          "name": "MIRNA_SNAPSHOT_UPLOAD_RATE_LIMITER",
          "namespace_id": "1009",
          "simple": { "limit": 10, "period": 60 },
        },
        {
          "name": "MIRNA_OPERATION_WRITE_RATE_LIMITER",
          "namespace_id": "1010",
          "simple": { "limit": 120, "period": 60 },
        },
        {
          "name": "MIRNA_DIAGNOSTICS_RATE_LIMITER",
          "namespace_id": "1011",
          "simple": { "limit": 30, "period": 60 },
        },
      ],
      "d1_databases": [
        {
          "binding": "MIRNA_SYNC_DB",
          "database_name": "mirna-sync-staging-eu",
          "database_id": "ce908dcc-d76a-4760-bef3-119894050290",
          "migrations_dir": "migrations",
          "migrations_table": "mirna_d1_migrations",
          "remote": true,
        },
      ],
      "r2_buckets": [
        {
          "binding": "MIRNA_SYNC_BUCKET",
          "bucket_name": "mirna-sync-staging-eu",
          "jurisdiction": "eu",
          "remote": true,
        },
      ],
      "triggers": {
        "crons": ["7 * * * *"],
      },
    },
  },
}
